# Copia este archivo como .env.local y rellena los valores (nunca subas .env.local a git).
# Los dos valores salen de Supabase → Project Settings → API.

# URL del proyecto: https://TU-REFERENCIA.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave PÚBLICA (sb_publishable_... o anon). NUNCA pongas aquí la service_role ni una clave secreta.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Avisos al móvil (push) ──
# Se generan con: node scripts/push-keys.mjs  (y la línea SQL que imprime se ejecuta en Supabase → SQL Editor)
# Solo NEXT_PUBLIC_VAPID_PUBLIC_KEY llega al navegador; las otras tres se quedan en el servidor.
# Si las dejas vacías, la app funciona igual y los avisos solo se ven dentro de la app.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@happa.es
PUSH_DISPATCH_SECRET=
