# Copia este archivo como .env.local y rellena los valores (nunca subas .env.local a git).
# Los dos valores salen de Supabase → Project Settings → API.

# URL del proyecto: https://TU-REFERENCIA.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave PÚBLICA (sb_publishable_... o anon). NUNCA pongas aquí la service_role ni una clave secreta.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
